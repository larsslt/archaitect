# Copy to .env.local (ignored by git). Everything here is optional.

# --- Language model: only for "house from text", text edits and English translation of dynamic strings.
# Everything else (rules, geometry, IFC, plans, undo) works without any model.
# Option A: Meta Model API (https://api.meta.ai/v1)
META_API_KEY=
# Option B: any OpenAI-compatible endpoint (LM Studio, vLLM, hosted)
BIMRENDER_LLM_URL=
BIMRENDER_LLM_KEY=
BIMRENDER_LLM_MODEL=
# Option C: local Ollama (default when no key/endpoint is set)
# ARCHAITECT_OLLAMA_MODEL=qwen3:8b

# --- Storage / paths
ARCHAITECT_DB_PATH=.local/archaitect.sqlite3
# BLENDER=/path/to/blender        # optional, photo renders only

# --- Frontend (put into apps/web/.env.local if you change it)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_DEFAULT_LANG=en     # en | de
